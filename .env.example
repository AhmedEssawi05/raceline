# Copy this file to `.env` and fill in real values. `.env` is git-ignored —
# never commit real secrets (Strava client secret, Fernet key).

# --- Postgres ---
# Used both by the `postgres` service itself (to initialize the DB) and by
# api/worker to build DATABASE_URL. Keep these three in sync with the URL below.
POSTGRES_USER=raceline
POSTGRES_PASSWORD=raceline
POSTGRES_DB=raceline

# SQLAlchemy connection string, read by app/config.py. Host is `postgres` (the
# docker-compose service name), not `localhost` — api/worker reach Postgres
# over the compose network. Uses psycopg v3 (`+psycopg`), not psycopg2.
DATABASE_URL=postgresql+psycopg://raceline:raceline@postgres:5432/raceline

# --- Redis / RQ ---
# Same service-name-as-host rule as Postgres. Read by worker/queue.py and
# (later) app code that enqueues backfill jobs.
REDIS_URL=redis://redis:6379/0

# --- Session cookie signing (Phase 1, required) ---
# Signs the login session cookie (app/main.py's SessionMiddleware) — with
# Strava OAuth as the only login method, this cookie *is* the auth
# mechanism, so the app refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# --- Token encryption (Phase 1, required) ---
# Fernet key used to encrypt Strava OAuth tokens at rest (app/security.py).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes all stored tokens permanently undecryptable — treat
# it like a database password, not a config knob.
FERNET_KEY=

# --- Strava OAuth (Phase 1, required to actually log in) ---
# From https://www.strava.com/settings/api — register a Strava API
# application to get these. The app boots without them, but hitting
# /auth/strava/login raises a clear error until they're filled in.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback

# --- Trained-model algorithm (Phase 4, optional) ---
# Selects which ml/registry.py entry backs the `trained_model` prediction
# method (see ml/train.py). Left commented out, not blank: pydantic-settings
# treats a *present-but-empty* var as the value "" (not "unset"), which
# would break the registry lookup — the Python-side default of
# "gradient_boosting" only applies when this line is absent entirely.
# Uncomment to point ml/train.py at a different registered algorithm (e.g.
# once ml/linear_baseline.py exists) without touching any code.
# RACELINE_MODEL_ALGORITHM=gradient_boosting
